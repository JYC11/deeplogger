{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "dart": {
      "type": "local",
      "command": ["fvm", "dart", "mcp-server", "--force-roots-fallback"],
      "enabled": true
    },
    "mobile-mcp": {
      "type": "local",
      "command": ["npx", "-y", "@mobilenext/mobile-mcp@latest"],
      "enabled": true,
      "environment": { "MOBILEMCP_DISABLE_TELEMETRY": "1" }
    }
  }
}
